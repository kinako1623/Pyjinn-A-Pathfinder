Thread = JavaClass("java.lang.Thread")
HashSet = JavaClass("java.util.HashSet")

Gizmos          = JavaClass("net.minecraft.gizmos.Gizmos")
GizmoStyle      = JavaClass("net.minecraft.gizmos.GizmoStyle")

Blocks = JavaClass("net.minecraft.world.level.block.Blocks")
BlockState = JavaClass("net.minecraft.world.level.block.state.BlockState")
BuiltInRegistries = JavaClass("net.minecraft.core.registries.BuiltInRegistries")
SlabBlock = JavaClass("net.minecraft.world.level.block.SlabBlock")
SlabType = JavaClass("net.minecraft.world.level.block.state.properties.SlabType")
MutableBlockPos = JavaClass("net.minecraft.core.BlockPos$MutableBlockPos")
BlockPos        = JavaClass("net.minecraft.core.BlockPos")

Vec3            = JavaClass("net.minecraft.world.phys.Vec3")
AABB            = JavaClass("net.minecraft.world.phys.AABB")
LineGizmo = JavaClass("net.minecraft.gizmos.LineGizmo")
Direction       = JavaClass("net.minecraft.core.Direction")
ARGB            = JavaClass("net.minecraft.util.ARGB")

color       = ARGB.color(255, 0, 200, 255)
fill_color  = ARGB.color(60,  0, 200, 255)
style       = GizmoStyle.stroke(color)
filled      = GizmoStyle.strokeAndFill(color, JavaFloat(1.5), fill_color)
