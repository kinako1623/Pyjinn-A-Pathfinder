line_width = JavaFloat(5.0)

mc = Minecraft.getInstance()
current_path = None
current_index = 1
listener_id2 = None
move_status = "idle"
async_next_path = None

level = mc.level
mutable_pos = MutableBlockPos()

jump_cooldown = 0
stuck_ticks = 0
last_waypoint_dist = 999999.0
path = None
debug_timer = 0
path_future = None

FINAL_WAYPOINT_THRESHOLD = 1.2
NORMAL_WAYPOINT_THRESHOLD = 1.4
WAYPOINT_OVERSHOOT_THRESHOLD = 0.2

def create_set_from_blocks(block_list):
    h_set = HashSet()
    for block in block_list:
        h_set.add(block)
    return h_set

# 2. 文字列を使わず、Blocksクラスのフィールドを直接指定
AIRLIKE = create_set_from_blocks([Blocks.AIR, Blocks.LIGHT])
LIQUIDS = create_set_from_blocks([Blocks.WATER, Blocks.LAVA])
IGNORE_BLOCKS = create_set_from_blocks([
    Blocks.AIR, 
    Blocks.OAK_SIGN, 
    Blocks.POPPY, 
    Blocks.TORCH,
    Blocks.LADDER, 
    Blocks.VINE, 
    Blocks.SHORT_GRASS, 
    Blocks.TALL_GRASS,
    Blocks.RAIL,
    Blocks.LEAF_LITTER,
    Blocks.WILDFLOWERS
    # ※ 注意: 一部のMODブロックやマイナーなブロックはBlocksクラスに存在しない場合があります
])

MAX_VERTICAL_STEP = 1
BODY_RADIUS = 0.3
LOS_BODY_OFFSETS = ((-BODY_RADIUS, -BODY_RADIUS), (-BODY_RADIUS, BODY_RADIUS), (BODY_RADIUS, -BODY_RADIUS), (BODY_RADIUS, BODY_RADIUS), (0.0, 0.0))

COST_CARDINAL = 1.0
COST_DIAGONAL = Math.sqrt(2.0)
COST_STEP_CARD = Math.sqrt(2.0)
COST_STEP_DIAG = Math.sqrt(3.5)
HEURISTIC_WEIGHT = 1.3

# utility functions for block checks

def is_bottom_slab(state):
    block = state.getBlock()
    if not isinstance(block, SlabBlock):
        return False
    try:
        slab_type = state.getValue(SlabBlock.TYPE)
        return slab_type == SlabType.BOTTOM
    except:
        return False

def get_state_cached(x, y, z, cache):
    key = (x, y, z)
    if key not in cache:
        cache[key] = level.getBlockState(mutable_pos.set(x, y, z))
    return cache[key]

def is_passable(state):
    block = state.getBlock()
    
    if AIRLIKE.contains(block) or IGNORE_BLOCKS.contains(block):
        return True
    if is_bottom_slab(state):
        return True
        
    return False

def is_supportive(state):
    block = state.getBlock()
    return not (LIQUIDS.contains(block) or AIRLIKE.contains(block) or IGNORE_BLOCKS.contains(block))

def is_supportive_cached(x, y, z, cache):
    key = ("sup", x, y, z)
    if key not in cache:
        cache[key] = is_supportive(get_state_cached(x, y, z, cache))
    return cache[key]

def is_solid_cached(x, y, z, cache):
    key = ("solid", x, y, z)
    if key not in cache:
        state = get_state_cached(x, y, z, cache)
        cache[key] = state.getMaterial().isSolid() 
    return cache[key]

def has_clearance_cached(x, y, z, cache):
    ix, iy, iz = int(Math.floor(x)), int(Math.floor(y)), int(Math.floor(z))
    key = ("clr", ix, iy, iz)
    if key not in cache:
        s1 = get_state_cached(ix, iy, iz, cache)
        s2 = get_state_cached(ix, iy + 1, iz, cache)
        cache[key] = is_passable(s1) and is_passable(s2)
    return cache[key]

class MinHeap:

    def __init__(self):
        self.pq = Queue()
        self.registry = {}

    def push(self, f, h, tie, item):
        key_str = f"{f:014.4f}_{h:014.4f}_{tie:010d}"
        self.pq.add(key_str)
        self.registry[key_str] = item

    def pop(self):
        if self.pq.isEmpty():
            return None
    
        key_str = self.pq.poll()
        item = self.registry[key_str]
        del self.registry[key_str]
        
        return item

    def is_empty(self):
        return self.pq.isEmpty()
    
class Node:
    __slots__ = ("pos","parent","G","H")

    def __init__(self, pos, parent=None):
        self.pos = (int(Math.floor(pos[0])), int(Math.floor(pos[1])), int(Math.floor(pos[2])))
        self.parent = parent
        self.G = 0.0
        self.H = 0.0

    def F(self):
        return self.G + HEURISTIC_WEIGHT * self.H

    def heuristic(self, goal):
            px, py, pz = self.pos
            gx, gy, gz = goal
            dx = px - gx
            dy = py - gy
            dz = pz - gz
            return Math.sqrt(dx * dx + dy * dy + dz * dz)

    def _diagonal_clearance_ok(self, cx, cy, cz, nx, ny, nz, cache) -> bool:
        dx, dz = nx - cx, nz - cz
        if int(Math.abs(dx)) == 1 and int(Math.abs(dz)) == 1:
            base_y = int(Math.min(cy, ny))
            if (ny - cy) > 0:
                if not has_clearance_cached(cx, base_y, cz + dz, cache): 
                    return False
            else:
                if not has_clearance_cached(cx + dx, base_y, cz, cache): 
                    return False
                if not has_clearance_cached(cx, base_y, cz + dz, cache): 
                    return False
        return True

    def is_walkable(self, pos, cache) -> bool:
        cx, cy, cz = self.pos
        nx, ny, nz = pos
        
        key = ("walk", cx, cy, cz, nx, ny, nz)
        if key in cache:
            return cache[key]

        dy = ny - cy

        if int(Math.abs(dy)) > MAX_VERTICAL_STEP:
            cache[key] = False
            return False

        if not has_clearance_cached(nx, ny, nz, cache):
            cache[key] = False
            return False

        if not is_supportive_cached(nx, ny - 1, nz, cache):
            cache[key] = False
            return False
        if dy > 0:
            if not has_clearance_cached(cx, cy + 1, cz, cache):
                cache[key] = False
                return False

        if dy < 0:
            state_above = get_state_cached(nx, cy + 1, nz, cache)
            if not has_clearance_cached(nx, cy, nz, cache):
                cache[key] = False
                return False
            if not is_passable(state_above):
                cache[key] = False
                return False

        if not self._diagonal_clearance_ok(cx, cy, cz, nx, ny, nz, cache):
            cache[key] = False
            return False
            
        cache[key] = True
        return True

    def neighbors_with_cost(self, cache):
        x, y, z = self.pos
        result = []
        dirs = [
            (1, 0, COST_CARDINAL), (-1, 0, COST_CARDINAL), (0, 1, COST_CARDINAL), (0, -1, COST_CARDINAL),
            (1, 1, COST_DIAGONAL), (1, -1, COST_DIAGONAL), (-1, 1, COST_DIAGONAL), (-1, -1, COST_DIAGONAL)
        ]
        for dx, dz, base_cost in dirs:
            p = (x + dx, y, z + dz)
            if self.is_walkable(p, cache):
                result.append((p, base_cost))
            else:
                p = (x + dx, y + 1, z + dz)
                if self.is_walkable(p, cache): result.append((p, COST_STEP_CARD if base_cost == COST_CARDINAL else COST_STEP_DIAG))
                    
                p = (x + dx, y - 1, z + dz)
                if self.is_walkable(p, cache): result.append((p, COST_STEP_CARD if base_cost == COST_CARDINAL else COST_STEP_DIAG))
        return result


# path reconstruction and smoothing
def reconstruct_path(node):
    path = []
    while node:
        path.append(node.pos)
        node = node.parent
    
    reversed_path = []
    n = len(path)
    for i in range(n):
        reversed_path.append(path[n - 1 - i])
    return reversed_path

def get_direction_table(path):
    directions = []

    for i in range(1, len(path)):
        x0, y0, z0 = path[i - 1]
        x1, y1, z1 = path[i]

        dx = x1 - x0
        dy = y1 - y0
        dz = z1 - z0

        directions.append((dx, dy, dz))

    return directions

def LOS(a, b, cache):
    x0, y0, z0 = a
    x1, y1, z1 = b
    dx, dy, dz = x1 - x0, y1 - y0, z1 - z0
    steps = max(abs(dx), abs(dy), abs(dz)) * 2
    if steps == 0:
        return True

    for i in range(steps + 1):
        t = i / steps
        cx = x0 + dx * t
        cy = y0 + dy * t
        cz = z0 + dz * t
        cy_i = round(cy)

        seen = set()
        for ox, oz in LOS_BODY_OFFSETS:
            bx = round(cx + ox)
            bz = round(cz + oz)
            if (bx, bz) in seen:
                continue
            seen.add((bx, bz))
            if not has_clearance_cached(bx, cy_i, bz, cache):
                return False

        if not is_supportive_cached(round(cx), cy_i - 1, round(cz), cache):
            return False

    return True

def smooth_path(path, cache):
    if len(path) <= 2:
        return path
        
    result = [path[0]]
    i = 0
    while i < len(path) - 1:
        j = i + 1
        while j < len(path):
            prev_y = path[j - 1][1]
            current_y = path[j][1]
            
            if current_y > prev_y:
                if j == i + 1:
                    j += 1
                break

            if not LOS(path[i], path[j], cache):
                break
            j += 1

        next_index = j - 1
        if next_index == i:
            next_index = i + 1

        result.append(path[next_index])
        i = next_index

    return result

def get_direction(p1, p2):
    return (p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2])

def path_find(start, goal, do_smooth=True):
    start_time = System.currentTimeMillis()
    
    start = (int(Math.floor(start[0])), int(Math.floor(start[1])), int(Math.floor(start[2])))
    goal  = (int(Math.floor(goal[0])), int(Math.floor(goal[1])), int(Math.floor(goal[2])))

    cache = {}
    start_node = Node(start)
    start_node.G = 0 
    start_node.H = start_node.heuristic(goal)

    pq = MinHeap()
    tie_breaker = 0
    
    pq.push(start_node.F(), start_node.H, tie_breaker, start_node)

    closed = set()
    node_map = {start: start_node}

    while not pq.is_empty():

        current = pq.pop()
        if current.pos in closed: continue
        if current.G > node_map[current.pos].G:
            continue
        if current.pos == goal:
            raw_path = reconstruct_path(current)
            final_path = raw_path
            
            elapsed = (System.currentTimeMillis() - start_time) / 1000.0
            echo(f"Expanded: {len(closed)}")
            echo(f"Generated: {tie_breaker}")
            echo(f"Pathfinding took {elapsed:.3f}s")
            return final_path

        closed.add(current.pos)
        parent = current.parent
        if parent:
            move_dir = get_direction(parent.pos, current.pos)
        else:
            move_dir = None

        for npos, step_cost in current.neighbors_with_cost(cache):
            if npos in closed: continue
            if move_dir:
                next_dir = get_direction(current.pos, npos)
                dot_product = (move_dir[0] * next_dir[0] + 
                               move_dir[1] * next_dir[1] + 
                               move_dir[2] * next_dir[2])
                if dot_product < 0:
                    continue
            parent_candidate = current
            tentative_G = current.G + step_cost

            neighbor = node_map.get(npos)
            if neighbor is None:
                neighbor = Node(npos, parent_candidate)
                neighbor.G = tentative_G
                neighbor.H = neighbor.heuristic(goal)
                node_map[npos] = neighbor
                tie_breaker += 1
                pq.push(neighbor.F(), neighbor.H, tie_breaker, neighbor)
            elif tentative_G + 1e-9 < neighbor.G:
                neighbor.parent = parent_candidate
                neighbor.G = tentative_G
                tie_breaker += 1
                pq.push(neighbor.F(), neighbor.H, tie_breaker, neighbor)

    raise ValueError("No path found")
    
def goto(x, y, z):
    global current_path
    global current_index
    global listener_id2
    global move_status
    global path
    global current_path
    global async_next_path
    global jump_cooldown
    global last_waypoint_dist
    global path_future

    listener_id2 = None
    move_status = "idle"
    async_next_path = None

    jump_cooldown = 0
    last_waypoint_dist = 999999.0
    path = None
    path_future = None

    current_path = None
    current_index = 0

    start = player_position()
    goal = (x, y, z)

    move_status = "searching"

    def task():
        echo("PATH THREAD START")
        try:
            result = path_find(start, goal)
            return result
        except Exception as e:
            echo(f"Error in pathfinding thread: {e}")
            raise e
            
    path_future = path_find(start, goal)

    if listener_id2 is None:
        listener_id2 = add_event_listener(
            "render",
            on_render
        )

    return path_future


#movement and rotation functions
def normalize_angle(angle):
    return (angle + 180.0) % 360.0 - 180.0

def face_position(px, py, pz):
    player = mc.player

    dx = px - player.getX()
    dz = pz - player.getZ()

    yaw = -(Math.atan2(dx, dz) * 180 / Math.PI)

    player.setYRot(yaw)

def move_forward(enable=True):
    mc.options.keyUp.setDown(enable)

def jump(enable=True):
    mc.options.keyJump.setDown(enable)

def stop_all():
    options = mc.options
    options.keyUp.setDown(False)
    options.keyJump.setDown(False)

def _min_jerk_curve(t):
    t = max(0.0, min(1.0, t))
    return 10.0 * t**3 - 15.0 * t**4 + 6.0 * t**5

def _ease_out_cubic(t):
    t = max(0.0, min(1.0, t))
    return 1.0 - (1.0 - t) ** 3

def _smooth_rotation_speed(delta, is_yaw=True, distance_to_target=None):
    abs_delta = abs(delta)

    coeff = 0.4 if is_yaw else 0.12

    proximity_damping = 1.0
    if distance_to_target is not None:
        if distance_to_target < 1.5:
            proximity_damping = 0.35
        elif distance_to_target < 2.5:
            proximity_damping = 0.55
        elif distance_to_target < 4.0:
            proximity_damping = 0.75

    if abs_delta < 2.0:
        speed = coeff * (abs_delta ** 1.2) * 0.2

    elif abs_delta < 13.0:
        norm_angle = abs_delta / 8.0
        eased = _min_jerk_curve(norm_angle)
        speed = coeff * eased

    elif abs_delta < 40.0:
        norm_angle = (abs_delta - 8.0) / 17.0
        eased = _ease_out_cubic(norm_angle)
        speed = 0.8 + eased * 2.8

    elif abs_delta < 60.0:
        norm_angle = (abs_delta - 25.0) / 35.0
        eased = _ease_out_cubic(norm_angle)
        speed = 1.0 + eased * 2.0

    else:
        speed = 2.0

    if not is_yaw:
        speed *= 0.4
        if speed > 0.6:
            speed = 0.6

    speed *= proximity_damping

    if speed < 0.01:
        speed = 0.01
    elif speed > 3.0:
        speed = 3.0

    if speed > abs_delta:
        speed = abs_delta

    return speed if delta > 0 else -speed

def update_rotation_and_movement(tx, ty, tz):
    player = mc.player

    dx = tx - player.getX()
    dy = ty - player.getY()
    dz = tz - player.getZ()

    dist_sq = dx * dx + dz * dz
    dist = Math.sqrt(dist_sq)

    target_yaw = -(
        Math.atan2(dx, dz)
        * 180.0
        / Math.PI
    )

    horizontal_dist = dist

    target_pitch = -(
        Math.atan2(dy, horizontal_dist)
        * 180.0
        / Math.PI
    )

    current_yaw = player.getYRot()

    delta_yaw = normalize_angle(
        target_yaw - current_yaw
    )

    abs_delta_yaw = abs(delta_yaw)

    yaw_speed = _smooth_rotation_speed(
        delta_yaw,
        is_yaw=True,
        distance_to_target=dist
    )

    new_yaw = current_yaw + yaw_speed

    if abs_delta_yaw < 0.08 and dist > 2.0:
        new_yaw = target_yaw
    elif abs_delta_yaw < 0.04:
        new_yaw = target_yaw

    current_pitch = player.getXRot()

    delta_pitch = target_pitch - current_pitch

    abs_delta_pitch = abs(delta_pitch)

    pitch_speed = _smooth_rotation_speed(
        delta_pitch,
        is_yaw=False,
        distance_to_target=dist
    )

    new_pitch = current_pitch + pitch_speed

    if abs_delta_pitch < 0.08 and dist > 2.0:
        new_pitch = target_pitch
    elif abs_delta_pitch < 0.04:
        new_pitch = target_pitch

    if new_pitch > 50:
        new_pitch = 50

    if new_pitch < -50:
        new_pitch = -50

    player.setYRot(new_yaw)
    player.setYHeadRot(new_yaw)
    player.setXRot(new_pitch)

    yaw_error = abs(
        normalize_angle(
            target_yaw - new_yaw
        )
    )

    movement_threshold = 25.0 if dist > 3.0 else 18.0

    if dist < 2.0:
        movement_threshold = 12.0

    if yaw_error < movement_threshold:
        move_forward(True)
    else:
        move_forward(False)

def on_render(e):
    global current_path
    global current_index
    global listener_id2
    global move_status
    global stuck_ticks
    global jump_cooldown
    global last_waypoint_dist
    global debug_timer

    if move_status == "searching":
        debug_timer += 1
        if debug_timer >= 20:
            debug_timer = 0
            echo("MAIN THREAD ALIVE")

        if path_future is not None:
            try:
                current_path = path_future
                current_index = 0
                move_status = "running"
                echo("PATH RECEIVED")
            except Exception as ex:
                move_status = "idle"
        return

    if current_path is None:
        return

    player = mc.player

    for point in current_path:
        Gizmos.cuboid(BlockPos(point[0], point[1], point[2]), filled)

    for i in range(len(current_path) - 1):
        x0, y0, z0 = current_path[i]
        x1, y1, z1 = current_path[i + 1]
        Gizmos.line(Vec3(x0 + 0.5, y0 + 0.5, z0 + 0.5), Vec3(x1 + 0.5, y1 + 0.5, z1 + 0.5), line_color, line_width).setAlwaysOnTop()

    if current_index >= len(current_path):
        stop_all()
        echo("Arrived!")
        move_status = "arrived"
        remove_event_listener(listener_id2)
        return

    point = current_path[current_index]

    tx = point[0] + 0.5
    ty = point[1]
    tz = point[2] + 0.5

    dx = tx - player.getX()
    dy = ty - player.getY()
    dz = tz - player.getZ()

    vel = player.getDeltaMovement()
    speed = Math.sqrt(vel.x * vel.x + vel.z * vel.z)

    dist_sq = dx * dx + dz * dz
    dist = Math.sqrt(dist_sq)

    is_final_waypoint = (current_index >= len(current_path) - 1)

    if current_index + 1 < len(current_path):
        next_point = current_path[current_index + 1]
        nx = next_point[0] + 0.5
        nz = next_point[2] + 0.5

        pdx = nx - player.getX()
        pdz = nz - player.getZ()
        player_to_next_sq = pdx * pdx + pdz * pdz

        cdx = nx - tx
        cdz = nz - tz
        current_to_next_sq = cdx * cdx + cdz * cdz

        if (player_to_next_sq < current_to_next_sq and not is_final_waypoint):
            last_waypoint_dist = 999999.0
            current_index += 1
            return

    waypoint_threshold = (
        FINAL_WAYPOINT_THRESHOLD
        if is_final_waypoint
        else NORMAL_WAYPOINT_THRESHOLD
    )

    if jump_cooldown > 0 and not is_final_waypoint:
        waypoint_threshold = max(waypoint_threshold, 1.4)

    if dist < waypoint_threshold:
        last_waypoint_dist = 999999.0
        current_index += 1

        if current_index >= len(current_path):
            echo("Reached final waypoint!")
        return

    if (not is_final_waypoint and dist > last_waypoint_dist + WAYPOINT_OVERSHOOT_THRESHOLD):
        current_index += 1
        last_waypoint_dist = 999999.0
        return

    last_waypoint_dist = dist

    update_rotation_and_movement(tx, ty, tz)

    jump_cooldown = max(0, jump_cooldown - 1)

    state_below = level.getBlockState(mutable_pos.set(tx, ty - 1, tz))
    is_slab_block = is_bottom_slab(state_below)
    should_normal_jump = False

    chev_dist = max(Math.abs(dx), Math.abs(dz))
    if not is_slab_block:
        if dy > 0.8 and chev_dist < 2.2:
            should_normal_jump = True
        elif dy > 1.2 and chev_dist < 3:
            should_normal_jump = True

    if should_normal_jump and jump_cooldown <= 0:
        jump(True)
        jump_cooldown = 4 
    else:
        jump(False)

    if speed < 0.03:
        stuck_ticks += 1
    else:
        stuck_ticks = 0

    if stuck_ticks > 15:
        jump(True) 
        jump_cooldown = 3
